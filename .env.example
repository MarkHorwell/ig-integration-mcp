# Generate separate API keys for the demo and live environments in IG's platform.
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=
IG_ENVIRONMENT=demo
# Optional. Defaults to the account selected by IG during login.
IG_ACCOUNT_ID=
# Persistent response cache. Set false to make every eligible read call IG.
IG_CACHE_ENABLED=true
# Optional. Defaults to ~/.cache/ig-mcp/cache.sqlite3.
IG_CACHE_PATH=
